# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=replace_with_bot_token

# Render sets RENDER_EXTERNAL_URL automatically. Set PUBLIC_URL locally when
# using a tunnel such as ngrok or Cloudflare Tunnel.
PUBLIC_URL=https://your-service.onrender.com

# Optional but recommended. Use a long random value.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Render provides PORT. 10000 is useful for local testing.
PORT=10000
